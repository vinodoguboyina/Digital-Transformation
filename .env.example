ADMIN_EMPLOYEE_ID=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# First-time bootstrap only. After you sign in, change the ID and password
# from Employee login → Change login on the website.
# Optional extra bootstrap accounts. Value after the first colon must be a scrypt hash from:
# npm run hash-password -- "your-password"
ADMIN_USERS=
# Required on Vercel so Edit / flyer / logo saves write to GitHub.
# Never commit a real token. Add it only in Vercel Environment Variables.
GITHUB_TOKEN=
